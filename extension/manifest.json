{
  "manifest_version": 3,
  "name": "СПП Радар — цена с вкладки WB",
  "version": "1.0.0",
  "description": "Когда вы открываете карточку товара Wildberries, расширение читает цену и отправляет её в локальный СПП-Радар.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.wildberries.ru/*",
    "https://card.wb.ru/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.wildberries.ru/catalog/*/detail.aspx*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
